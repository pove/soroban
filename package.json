{
  "name": "soroban",
  "version": "3.5.0",
  "description": "Interactive Japanese abacus (soroban) game and printable practice-card generator",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm test && npm run test:e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pove/soroban.git"
  },
  "homepage": "https://pove.github.io/soroban/",
  "bugs": {
    "url": "https://github.com/pove/soroban/issues"
  },
  "keywords": [
    "soroban",
    "abacus",
    "education",
    "math",
    "pwa",
    "printable-cards"
  ]
}
